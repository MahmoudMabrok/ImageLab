# GPU profile: Kromoss INT8 ConvRot + w4a8 text encoder.
# Needs ~14 GB of weights, so a 24 GB card is comfortable (16 GB is tight).
# int8 attention requires CUDA (or HIP); do not use this profile on CPU.
IMAGELAB_UNET=kromoss_int8_convrot.safetensors
IMAGELAB_UNET_LOADER=UNETLoader
IMAGELAB_CLIP=qwen3.5_9b_w4a8_gptq.safetensors
IMAGELAB_CLIP_TYPE=moss_image
IMAGELAB_VAE=flux2-vae_small.safetensors
IMAGELAB_LORA=8-steps-dmd2-lora.safetensors
IMAGELAB_DEVICE_LABEL=GPU · INT8
IMAGELAB_DEFAULT_WIDTH=1024
IMAGELAB_DEFAULT_HEIGHT=1024
IMAGELAB_DEFAULT_STEPS=8
IMAGELAB_MAX_DIMENSION=2048
IMAGELAB_MAX_STEPS=16
IMAGELAB_ETA_SCALE=0.04
