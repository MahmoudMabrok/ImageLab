# Engine
COMFY_URL=http://127.0.0.1:8188
COMFY_OUTPUT_DIR=/srv/ComfyUI/output

# Model files (names inside ComfyUI/models)
IMAGELAB_UNET=kromoss-Q4_K_M.gguf
IMAGELAB_UNET_LOADER=UnetLoaderGGUF
IMAGELAB_CLIP=qwen3.5_9b_w4a8_gptq.safetensors
IMAGELAB_CLIP_TYPE=moss_image
IMAGELAB_VAE=flux2-vae_small.safetensors
IMAGELAB_LORA=8-steps-dmd2-lora.safetensors
IMAGELAB_LORA_STRENGTH=1.0
IMAGELAB_SAMPLER=euler
IMAGELAB_SCHEDULER=simple
# "cpu" keeps the text encoder off the compute device (useful on GPU hosts)
IMAGELAB_CLIP_DEVICE=default
IMAGELAB_DEVICE_LABEL=CPU · 8 vCPU
# Multiply the rough ETA; calibrate with `make trial`
IMAGELAB_ETA_SCALE=1

# Defaults and limits
IMAGELAB_DEFAULT_WIDTH=512
IMAGELAB_DEFAULT_HEIGHT=512
IMAGELAB_DEFAULT_STEPS=8
IMAGELAB_DEFAULT_CFG=1.0
IMAGELAB_MAX_STEPS=16
IMAGELAB_MAX_DIMENSION=1024
IMAGELAB_MIN_DIMENSION=256

# Images self-destruct this many seconds after they are ready
IMAGELAB_TTL_SECONDS=300
IMAGELAB_JOB_TIMEOUT=3600

# Server
IMAGELAB_DATA_DIR=/srv/imagelab/data
IMAGELAB_HOST=0.0.0.0
IMAGELAB_PORT=8080
# Set to the public URL when you want absolute image/MCP links
IMAGELAB_PUBLIC_URL=
# Optional shared secret for the UI, REST and MCP
IMAGELAB_API_KEY=
