[Unit]
Description=Cloudflare quick tunnel for ImageLab
After=network-online.target imagelab.service
Wants=network-online.target imagelab.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
